{
  "name": "hydrosnap-3d",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "vite",
    "api:dev": "tsx watch server/index.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:backfill": "tsx scripts/backfill_001_payloads.ts",
    "db:seed:dev": "tsx scripts/seed-dev.ts",
    "db:compute-drainage": "tsx scripts/compute_drainage.ts",
    "data:import-streams": "tsx scripts/import_streams.ts",
    "satellite:enqueue-refresh": "tsx scripts/satellite/enqueue_refresh.ts",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "vitest run server/__tests__",
    "check": "pnpm typecheck && pnpm test && pnpm test:server && pnpm build",
    "bhuvan:verify": "node --experimental-strip-types scripts/bhuvan/verify-layers.mts"
  },
  "dependencies": {
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jose": "^6.2.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.6.2",
    "pg": "^8.23.1",
    "pmtiles": "^4.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "3.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "^0.2.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vitest": "^5.0.3"
  }
}
