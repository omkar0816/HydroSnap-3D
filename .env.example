# Frontend data API. Keep mock mode off by default so the app talks to the real API.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=false
# When API collections are empty, show clearly labelled illustrative fixtures.
VITE_DEMO_EMPTY_FALLBACK=true

# Required to access the field workspace (Supabase URL + publishable/anon key).
# Never put a service_role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local PostgreSQL/PostGIS settings. These defaults are for development only.
POSTGRES_USER=hydrosnap
POSTGRES_PASSWORD=hydrosnap
POSTGRES_DB=hydrosnap
DATABASE_URL=postgresql://hydrosnap:hydrosnap@localhost:5432/hydrosnap
API_PORT=8000
API_PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8443,http://localhost:5173
UPLOAD_DIRECTORY=storage/uploads

# Optional: official watershed boundaries as PMTiles (see scripts/prepare_watersheds).
# Example for a file placed in public/data/: /data/watersheds_pune.pmtiles
# The URL must be absolute when hosted elsewhere (HTTP range requests required).
VITE_WATERSHED_PMTILES_URL=
VITE_WATERSHED_ATTRIBUTION=

# Server-only pilot-summary settings. These do not use the VITE_ prefix.
# Set the real values in Vercel Project Settings > Environment Variables.
# The field photo/location checks do not use an AI API key.
# Keep the optional pilot-summary key out of source control and the browser.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
# Server-only vision model used when an image is present.
OMNIROUTE_VISION_MODEL=
# Optional comma-separated additional origins for the pilot-summary endpoint.
PILOT_SUMMARY_ALLOWED_ORIGINS=

# --- Bhuvan (NRSC / ISRO) thematic layers --------------------------------
# WMS needs NO API key. The browser calls this same-origin path; Vite (dev,
# see vite.config.ts) and Vercel (prod, see vercel.json) forward it to
# https://bhuvan-vec2.nrsc.gov.in/bhuvan. Change only if you host your own proxy.
VITE_BHUVAN_WMS_BASE=/bhuvan-wms/wms
# Bhuvan state code (MH = Maharashtra) and district used for IWMP layers.
VITE_BHUVAN_STATE_CODE=MH
VITE_BHUVAN_DISTRICT=PUNE
# Dev proxy target override (rarely needed).
BHUVAN_PROXY_TARGET=https://bhuvan-vec2.nrsc.gov.in
# OPTIONAL, server-side only. The Bhuvan REST API (geocoding, LULC statistics)
# uses a personal token from https://bhuvan-app1.nrsc.gov.in/api that EXPIRES
# DAILY. Not used by the map layers; never expose it with a VITE_ prefix.
BHUVAN_API_TOKEN=

# --- Satellite analysis worker -------------------------------------------
# Worker reads Sentinel-2 L2A from the public Element84 Earth Search STAC API.
# No Earth Engine credentials or catalogue API key are used.
CLOUD_COVER_LIMIT=30

# --- DiCRA STAC catalogue (server-side requests) -------------------------
DICRA_STAC_BASE_URL=https://dicra.nabard.org/api-stac
DICRA_REQUEST_TIMEOUT_MS=20000
DICRA_COLLECTIONS_CACHE_TTL_SECONDS=300
DICRA_MAX_SEARCH_LIMIT=100
# The public read-only endpoints were verified without authentication.
# Keep this empty unless DiCRA confirms a key is required; the integration
# currently does not send or expose an API key.
DICRA_API_KEY=
DICRA_API_KEY_HEADER=Authorization
DICRA_API_KEY_PREFIX=Bearer
