# Backend (planned). Keep mock mode on until the FastAPI service exists.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=true

# Optional: official watershed boundaries as PMTiles (see scripts/prepare_watersheds).
# Example for a file placed in public/data/: /data/watersheds_pune.pmtiles
# The URL must be absolute when hosted elsewhere (HTTP range requests required).
VITE_WATERSHED_PMTILES_URL=
VITE_WATERSHED_ATTRIBUTION=

# Server-only pilot-summary settings. These do not use the VITE_ prefix.
# Set the real values in Vercel Project Settings > Environment Variables.
# The field photo/location checks do not use an AI API key.
# Keep the optional pilot-summary key out of source control and the browser.
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
# Server-only vision model used when an image is present.
OMNIROUTE_VISION_MODEL=
# Optional comma-separated additional origins for the pilot-summary endpoint.
PILOT_SUMMARY_ALLOWED_ORIGINS=
