# Backend (planned). Keep mock mode on until the FastAPI service exists.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_API=true

# Optional: official watershed boundaries as PMTiles (see scripts/prepare_watersheds).
# Example for a file placed in public/data/: /data/watersheds_pune.pmtiles
# The URL must be absolute when hosted elsewhere (HTTP range requests required).
VITE_WATERSHED_PMTILES_URL=
VITE_WATERSHED_ATTRIBUTION=

# Server-only Vercel AI settings. These do not use the VITE_ prefix.
# Set the real values in Vercel Project Settings > Environment Variables.
# Keep the Gemini key out of source control and browser-visible environment.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated additional origins; same-origin requests are allowed.
PHOTO_AI_ALLOWED_ORIGINS=
